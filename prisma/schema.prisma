generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Example: file:./db/custom.db
  // Resolves relative to prisma/schema.prisma; see .env.example.
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  records      TreeRecord[]
}

model TreeRecord {
  recordNumber Int        @id @default(autoincrement())
  plantedAt    DateTime
  speciesLatin String
  lat          Float
  lng          Float
  locality     String?
  orpKod       Int?
  photoPath    String?
  note         String?
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reminders    Reminder[]

  @@index([createdById, orpKod])
}

model Reminder {
  id           String     @id @default(uuid())
  text         String
  mode         String     // "interval" | "date"
  intervalNum  Int?
  intervalUnit String?    // "day" | "week" | "month" | "year"
  startAt      DateTime?
  dueAt        DateTime?  // jednorázové datum
  nextDueAt    DateTime
  active       Boolean    @default(true)
  recordNumber Int
  record       TreeRecord @relation(fields: [recordNumber], references: [recordNumber], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model Species {
  id        String   @id @default(uuid())
  latinName String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
