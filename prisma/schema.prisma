generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // e.g. file:./db/custom.db → prisma/db/custom.db — see .env.example
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  records      TreeRecord[]
  activityLogs ActivityLog[]
}

model TreeRecord {
  recordNumber Int        @id @default(autoincrement())
  plantedAt    DateTime
  speciesLatin String
  lat          Float
  lng          Float
  locality     String?
  photoPath    String?
  note         String?
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reminders    Reminder[]
}

model Reminder {
  id           String     @id @default(uuid())
  text         String
  mode         String     // "interval" | "date"
  intervalNum  Int?
  intervalUnit String?    // "day" | "week" | "month" | "year"
  startAt      DateTime?
  dueAt        DateTime?  // jednorázové datum
  nextDueAt    DateTime
  active       Boolean    @default(true)
  recordNumber Int
  record       TreeRecord @relation(fields: [recordNumber], references: [recordNumber], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String   // "create", "update", "delete", "ack"
  entityType String   // "record" or "reminder"
  entityId   String   // recordNumber as string or reminder id
  details    String?  // JSON string of what changed
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}
